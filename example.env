# Copy to .env (gitignored). Single keys via *_API_KEY; pools via *_API_KEYS
# (comma-separated) fail over automatically on quota/rate-limit responses.
# Give each role (model under test, judge, TTS) its own key where possible, so
# one role exhausting a quota cannot look like another role's failure.

GEMINI_API_KEY=
GEMINI_API_KEYS=
DEEPGRAM_API_KEY=
DEEPGRAM_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEYS=

# Per-role model routing (each Gemini model id has its own free quota bucket)
# VOXPARITY_GEMINI_MUT_MODEL=gemini-3.7-flash
# VOXPARITY_JUDGE_MODEL=gemini-3.6-flash
# VOXPARITY_TTS_MODEL=gemini-2.5-flash-preview-tts
# VOXPARITY_CASCADE_LLM=gemini-3.5-flash
# VOXPARITY_LLAMACPP_URL=http://127.0.0.1:8801

# OpenRouter — one adapter, many audio-native models (free: nemotron-omni, inkling)
# comma-separated for pool failover, same as the other providers
OPENROUTER_API_KEYS=

# --- added Sep 20 (D110 restore checklist; values live only in .env, never here) ---
GEMINI_PAID_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
XAI_API_KEY=
STEPFUN_API_KEY=
HF_TOKEN=
CAMB_API_KEY=
FISHAUDIO_API_KEY=
INWORLD_API_KEY=
